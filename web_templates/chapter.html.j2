{#
  chapter.html.j2  |  the chapter reader  |  Phase W2

  Everything the reader needs to navigate sits OUTSIDE <article id="chapter-text">.
  That boundary is load bearing: gate W1 measures the text inside the article and
  nothing else, so chrome can say whatever it needs to without the gate mistaking
  it for the chapter. Add navigation labels here freely. Never add text inside the
  article, because that is the book.
#}<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ chapter_title }} | AI Operations Management</title>
<meta name="description" content="Chapter {{ chapter_number }} of AI Operations Management. {{ part_label }}.">
{% if preview %}
<meta name="robots" content="noindex, nofollow">
{% endif %}
<link rel="stylesheet" href="../assets/aiom_web.css">
</head>
<body>

<div class="progress" data-chrome aria-hidden="true"><i id="progress-bar"></i></div>

<header class="topbar" data-chrome>
  <a class="brand" href="../">AI Operations Management</a>
  <span class="topbar-here" id="topbar-here"></span>
  <a class="cta" href="../#editions">Get the book</a>
  <button class="rail-toggle" id="rail-toggle" aria-expanded="false" aria-controls="rail">Contents</button>
</header>

{% if preview %}
<p class="preview-flag" data-chrome>Preview build. This chapter is not locked and is not published.</p>
{% endif %}

<div class="layout">

  <nav class="rail" id="rail" data-chrome aria-label="Chapter contents">
    <a class="rail-back" href="../">All parts</a>
    {% for p in book %}
    <p class="rail-part">Part {{ p.numeral }} <span>{{ p.name }}</span></p>
    <ol class="rail-chapters">
      {% for c in p.chapters %}
      {% if c.number|string == chapter_number %}
      <li class="rail-current">
        <span class="rail-ch here">Ch. {{ c.number }} {{ c.short }}</span>
        <p class="rail-meta">
          {{ "{:,}".format(counts.words) }} words, about {{ counts.minutes }} minutes<br>
          {{ counts.key_terms }} key terms, {{ notes|length }} sources,
          {{ counts.figures }} figures
        </p>
        <ol class="rail-slots">
          {% for s in slots %}
          <li><a href="#{{ s.id }}" data-rail="{{ s.id }}">{{ s.label }}</a>
            {% if s.key == 'teaching-body' and sections %}
            <ol class="rail-sections">
              {% for sec in sections %}
              <li><a href="#{{ sec.id }}" data-rail="{{ sec.id }}"><span class="rail-num">{{ sec.num }}</span> {{ sec.title }}</a></li>
              {% endfor %}
            </ol>
            {% endif %}
          </li>
          {% endfor %}
        </ol>
      </li>
      {% elif c.locked %}
      <li><a class="rail-ch" href="../{{ c.slug }}/">Ch. {{ c.number }} {{ c.short }}</a></li>
      {% else %}
      <li><span class="rail-ch soon">Ch. {{ c.number }} {{ c.short }}</span></li>
      {% endif %}
      {% endfor %}
    </ol>
    {% endfor %}
  </nav>

  <main class="reading">
    <article id="chapter-text">
<p class="part-label">{{ part_label }}</p>
<h1 class="chapter-title">{{ chapter_title }}</h1>
{{ body|safe }}
    </article>
  </main>

</div>

<footer class="foot" data-chrome>
  <div class="foot-inner">
    <p>AI Operations Management, Chapter {{ chapter_number }}. {{ part_label }}.</p>
    <p>{{ notes|length }} source note{{ '' if notes|length == 1 else 's' }}, each cited to the chapter register.</p>
    <p class="keyhint"><kbd>j</kbd> <kbd>k</kbd> move by section, <kbd>c</kbd> contents, <kbd>Esc</kbd> close.</p>
    <p class="foot-cta"><a class="cta" href="../#editions">Get the book</a></p>
  </div>
</footer>

<script>
(function () {
  'use strict';
  var art = document.getElementById('chapter-text');
  var bar = document.getElementById('progress-bar');
  var here = document.getElementById('topbar-here');
  var links = Array.prototype.slice.call(document.querySelectorAll('[data-rail]'));
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- progress ---- */
  function progress() {
    var span = art.offsetHeight - window.innerHeight;
    var seen = window.scrollY - art.offsetTop;
    var pct = span > 0 ? Math.min(1, Math.max(0, seen / span)) : 0;
    bar.style.transform = 'scaleX(' + pct + ')';
  }
  window.addEventListener('scroll', progress, { passive: true });
  window.addEventListener('resize', progress);
  progress();

  /* ---- which section am I in ---- */
  var targets = links.map(function (a) {
    return document.getElementById(a.getAttribute('data-rail'));
  }).filter(Boolean);

  function mark() {
    var y = window.scrollY + 140, current = null;
    targets.forEach(function (el) {
      if (el.getBoundingClientRect().top + window.scrollY <= y) { current = el; }
    });
    links.forEach(function (a) { a.classList.remove('here'); });
    if (!current) { here.textContent = ''; return; }
    var link = links.filter(function (a) {
      return a.getAttribute('data-rail') === current.id;
    })[0];
    if (link) {
      link.classList.add('here');
      here.textContent = link.textContent.trim();
    }
  }
  window.addEventListener('scroll', mark, { passive: true });
  mark();

  /* ---- reveal on first view ----
     The class is added HERE rather than in the markup, so a reader without
     JavaScript sees every block instead of a blank column. */
  if (!reduce && 'IntersectionObserver' in window) {
    var blocks = art.querySelectorAll(
      'figure, .theorem, .definition, .model, .dated, .kt-list, table.inv, .summary');
    Array.prototype.forEach.call(blocks, function (el) { el.classList.add('reveal'); });
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('shown'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px', threshold: 0 });
    /* rootMargin is deliberately zero. A negative bottom inset delays the
       reveal slightly and buys a bug: an element that sits entirely inside the
       inset band at maximum scroll never intersects, so it stays at opacity 0
       with no way for the reader to recover it. */
    Array.prototype.forEach.call(blocks, function (el) { io.observe(el); });
  }

  /* ---- sidenote highlighting, both directions ---- */
  art.addEventListener('click', function (e) {
    var a = e.target.closest ? e.target.closest('a.fnref, a.note-n') : null;
    if (!a) { return; }
    var id = a.getAttribute('href').slice(1);
    var el = document.getElementById(id);
    if (!el) { return; }
    art.querySelectorAll('.lit').forEach(function (n) { n.classList.remove('lit'); });
    el.classList.add('lit');
    var partner = document.getElementById(
      id.indexOf('fnref-') === 0 ? id.replace('fnref-', 'fn-') : id.replace('fn-', 'fnref-'));
    if (partner) { partner.classList.add('lit'); }
  });

  /* ---- rail toggle ---- */
  var toggle = document.getElementById('rail-toggle');
  var rail = document.getElementById('rail');
  function setRail(open) {
    rail.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  toggle.addEventListener('click', function () { setRail(!rail.classList.contains('open')); });
  rail.addEventListener('click', function (e) { if (e.target.tagName === 'A') { setRail(false); } });

  /* ---- keyboard ---- */
  function step(dir) {
    var y = window.scrollY + 130;
    var tops = targets.map(function (el) {
      return el.getBoundingClientRect().top + window.scrollY;
    });
    var i = -1;
    tops.forEach(function (t, n) { if (t <= y + 4) { i = n; } });
    var next = Math.min(targets.length - 1, Math.max(0, i + dir));
    if (dir < 0 && i >= 0 && tops[i] < y - 12) { next = i; }
    if (targets[next]) {
      targets[next].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }
  }
  document.addEventListener('keydown', function (e) {
    if (e.metaKey || e.ctrlKey || e.altKey) { return; }
    var t = e.target.tagName;
    if (t === 'INPUT' || t === 'TEXTAREA' || e.target.isContentEditable) { return; }
    if (e.key === 'j') { e.preventDefault(); step(1); }
    else if (e.key === 'k') { e.preventDefault(); step(-1); }
    else if (e.key === 'c') { e.preventDefault(); setRail(!rail.classList.contains('open')); }
    else if (e.key === 'Escape') { setRail(false); }
  });
})();
</script>

</body>
</html>
