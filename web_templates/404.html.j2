{# THE 404 PAGE IS THE ONE PAGE THAT CANNOT USE RELATIVE PATHS.
   GitHub Pages serves it for ANY missing address, at any depth, and the
   browser keeps the requested URL, so "../assets" resolves differently
   every time. Root-absolute paths are wrong too: on a PROJECT site at
   /textbook.aiom/ they point at the root of the user site, which is how
   this page shipped unstyled with every link leading out of the book.
   `base` is the deploy prefix, passed by --base-path, empty at the root.
   Gate W15 serves the tree at that prefix and fails if a subresource
   404s, so this cannot silently regress. #}
<!doctype html>
<html lang="en-US">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Page not found | AI Operations Management</title>
<link rel="stylesheet" href="{{ base }}/assets/aiom_web.css">
{% include "_theme.html.j2" %}
</head>
<body class="home ref">
<header class="topbar" data-chrome>
  <a class="brand" href="{{ base }}/">AI Operations Management</a>
  <nav class="topnav"><a href="{{ base }}/">The book</a><a href="{{ base }}/search/">Search</a></nav>
  {% include "_theme_button.html.j2" %}
</header>
<main>
  <section class="band band-first">
    <div class="band-head">
      <p class="eyebrow">404</p>
      <h2>That page is not here</h2>
    </div>
    <p class="note-line">The address may be mistyped, or it may point at a chapter
       that has not been published yet. Chapters appear as they lock.</p>
    <p class="hero-actions">
      <a class="btn" href="{{ base }}/">Go to the book</a>
      <a class="btn btn-quiet" href="{{ base }}/search/">Search the text</a>
    </p>
  </section>
</main>
</body>
</html>
